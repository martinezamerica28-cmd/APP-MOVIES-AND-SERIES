# Sin estas variables, la app funciona con catálogo ficticio y datos locales.
EXPO_PUBLIC_CATALOG_URL=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Solo servidor. Nunca usar EXPO_PUBLIC_ para este token.
TMDB_TOKEN=
# Esquema REVERSED_CLIENT_ID del cliente OAuth iOS; se usa al compilar.
GOOGLE_IOS_URL_SCHEME=

# Opcional: IP Wi-Fi del PC si la selección automática elige otra interfaz.
CATALOG_LAN_HOST=
